# klee modül yükleyici (GELİŞTİRME ARACI; Slot A öncesi kaldırılacak)
service klee_modsvc /system/bin/sh /mnt/klee_mod/service.sh
    user root
    group root log readproc
    seclabel u:r:oneuidbg:s0
    disabled
    oneshot

on post-fs-data
    exec u:r:oneuidbg:s0 root root -- /system/bin/sh /system/bin/klee_modmount.sh
    start klee_modsvc

on property:sys.boot_completed=1
    exec_background u:r:oneuidbg:s0 root root -- /system/bin/rm -f /data/local/tmp/klee_mod/pending
